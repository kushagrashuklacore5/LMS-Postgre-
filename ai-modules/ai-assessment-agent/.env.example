# AI Assessment Agent - environment reference
# The agent reads the LMS server's environment (server/.env). It has NO .env of
# its own and NO API key variable of its own.

# --- AI generation: SHARED with the Student Onboarding Agent (already in server/.env) ---
# SOA_LLM_PROVIDER=gemini          # only "gemini" is supported
# SOA_LLM_MODEL=<gemini model name>
# SOA_GEMINI_API_KEY=<secret>      # never commit; never copy into this module

# --- AI generation: assessment-agent settings (optional, non-secret) ---
# "false" turns AI generation off; manual test creation is unaffected. Default: on when configured.
AIA_AI_GENERATION_ENABLED=true
# Timeout for one generation request in ms (5000-120000). Default: 60000.
AIA_LLM_TIMEOUT_MS=60000
