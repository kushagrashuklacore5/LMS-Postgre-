{
  "name": "ai-assessment-agent",
  "version": "0.2.0",
  "description": "AI Assessment Agent - isolated LMS module for MCQ assessments: manual authoring (Step 1) and Gemini-proposed questions with strict validation and teacher review (Step 2).",
  "private": true,
  "license": "UNLICENSED",
  "main": "backend/src/integration/lmsAssessmentAgent.js",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\"",
    "gemini:manual": "node tests/manual/realGeminiCheck.js",
    "llm:manual": "node tests/manual/realLlmCheck.js",
    "e2e:browser": "node tests/e2e/browserE2E.js",
    "test:ai": "node --test \"tests/ai/*.test.js\" \"tests/analytics/*.test.js\" tests/questionTypes/generation.test.js tests/assignments/evaluation.test.js",
    "test:assignments": "node --test \"tests/assignments/*.test.js\"",
    "test:http": "node --test \"tests/lms-integration/*.test.js\"",
    "cost:estimate": "node tests/manual/estimatePromptCost.js"
  },
  "dependencies": {
    "pdf-parse": "2.4.5"
  }
}
