# Student Onboarding Agent - environment template
# Copy to .env inside this module folder only. Never commit real values.
# Read so far: SOA_PORT, SOA_IMPORT_*, SOA_LLM_PROVIDER, SOA_LLM_MODEL,
# SOA_GEMINI_API_KEY, SOA_HUGGINGFACE_MODEL, SOA_HUGGINGFACE_API_KEY (or HF_TOKEN),
# SOA_LLM_TIMEOUT_MS, SOA_MAPPING_SAMPLES_PER_COLUMN
# (SOA_IMPORT_MAX_JOBS / SOA_IMPORT_JOB_TTL_MINUTES via loadImportJobConfig()).
# The rest document planned configuration.

# --- Module ---
SOA_ENV=development
SOA_PORT=5055

# --- LLM provider (used for column mapping only) ---
# gemini | huggingface are implemented; openai is planned. Leave the key or model
# empty and the provider is "not configured" (nothing is called; manual mapping).
SOA_LLM_PROVIDER=huggingface
# --- huggingface (Inference Providers router, chat completions) ---
# Required, no default: "org/model" or "org/model:inference-provider",
# e.g. Qwen/Qwen3-Next-80B-A3B-Instruct:deepinfra
SOA_HUGGINGFACE_MODEL=
# Hugging Face access token (hf_...). May be left empty when HF_TOKEN is set in the same .env.
SOA_HUGGINGFACE_API_KEY=
# --- gemini ---
# Required for gemini, no default: the Gemini model name to use.
SOA_LLM_MODEL=
SOA_GEMINI_API_KEY=
SOA_OPENAI_API_KEY=
# Give up on an LLM call after this many milliseconds.
SOA_LLM_TIMEOUT_MS=30000

# --- Column mapping ---
# Masked sample values per Excel column shown to the LLM (1-10).
SOA_MAPPING_SAMPLES_PER_COLUMN=3
# LLM "mapped" suggestions below this confidence need an admin decision (0-1)
SOA_MAPPING_MIN_CONFIDENCE=0.7

# --- Email (planned; module-owned, does not reuse the LMS mailer) ---
SOA_EMAIL_ENABLED=false
SOA_EMAIL_FROM=
SOA_SMTP_HOST=
SOA_SMTP_PORT=
SOA_SMTP_USER=
SOA_SMTP_PASS=

# --- Excel import limits (used by POST /import/parse) ---
# Max data rows per worksheet; larger files are rejected (TOO_MANY_ROWS).
SOA_IMPORT_MAX_ROWS=5000
# Max upload size in MB; larger uploads are rejected with HTTP 413 (FILE_TOO_LARGE).
SOA_IMPORT_MAX_FILE_MB=10

# --- Import jobs (in-memory store; lost on restart) ---
# Max open jobs; new jobs are refused (JOB_STORE_FULL) when reached.
SOA_IMPORT_MAX_JOBS=50
# Jobs (including approved ones) are discarded this many minutes after creation.
SOA_IMPORT_JOB_TTL_MINUTES=120
