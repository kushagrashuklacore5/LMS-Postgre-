{
  "name": "unstop-lms-server",
  "version": "1.0.0",
  "description": "Backend server for Unstop LMS",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:setup": "node scripts/postgres/setup-database.js",
    "db:migrate": "node database/postgres/migrate.js",
    "db:status": "node database/postgres/migrate.js --status",
    "db:import-sqlite": "node scripts/postgres/import-sqlite.js",
    "db:backup": "node scripts/ops/backup-and-verify.js",
    "test": "node --test --test-force-exit \"tests/**/*.test.js\"",
    "test:security": "node --test --test-force-exit \"tests/security/*.test.js\" \"tests/integrity/*.test.js\"",
    "e2e:stack": "node tests/e2e/stack.js",
    "e2e:browser": "node tests/e2e/portals.e2e.js"
  },
  "dependencies": {
    "axios": "^1.13.6",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "lru-cache": "^11.3.5",
    "mongodb": "^7.0.0",
    "mongoose": "^7.5.0",
    "multer": "^2.0.2",
    "node-fetch": "^3.3.2",
    "nodemailer": "^10.1.0",
    "path": "^0.12.7",
    "pdfkit": "^0.17.2",
    "pg": "^8.23.0",
    "puppeteer": "^25.13.0",
    "rate-limit-redis": "^4.3.1",
    "razorpay": "^2.9.6",
    "socket.io": "^4.8.3",
    "sqlite3": "^6.0.1",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "keywords": [
    "lms",
    "education",
    "nodejs"
  ],
  "author": "",
  "license": "ISC",
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "sqlite3@6.0.1": true
  }
}
