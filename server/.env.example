# Copy this file to server/.env and fill in real values. Never commit server/.env.
# The server refuses to start when a required value is missing or still a placeholder.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# "development" on your own machine, "production" on a server used by a school.
NODE_ENV=development
PORT=5002

# Web addresses allowed to call this API from a browser (comma separated).
# REQUIRED in production. In development the local Vite ports are allowed automatically.
# Example: CORS_ORIGINS=https://lms.yourschool.example
CORS_ORIGINS=

# Number of reverse proxies in front of this server (nginx, a load balancer...).
# Leave empty when clients connect directly. Needed for correct rate limiting behind a proxy.
TRUST_PROXY_HOPS=

# ---------------------------------------------------------------------------
# Sign-in tokens (REQUIRED)
# ---------------------------------------------------------------------------
# Two DIFFERENT long random values, at least 32 characters each. Generate each one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing JWT_SECRET signs every user out once.
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# The LMS stores its data in PostgreSQL. The server refuses to start without a reachable,
# fully migrated database (there is no SQLite fallback). Set-up: docs/POSTGRESQL.md
#
# What the server runs as: the least-privilege role (rows only; no CREATE/ALTER/DROP/TRUNCATE).
# Put the real password here in server/.env only; never commit it.
DATABASE_URL=postgres://lms_app:<LMS_APP_PASSWORD>@localhost:5432/lms
# Alternatively leave DATABASE_URL unset and use PGHOST / PGPORT / PGDATABASE / PGUSER / PGPASSWORD.
#
# Used ONLY by `npm run db:migrate`, `npm run db:status` and the SQLite import: the schema owner role.
DATABASE_MIGRATION_URL=postgres://lms_owner:<LMS_OWNER_PASSWORD>@localhost:5432/lms
#
# Optional tuning
# PG_POOL_MAX=10                # connections the server keeps open
# PG_CONNECT_TIMEOUT_MS=10000   # give up one connection attempt after this long
# PG_CONNECT_ATTEMPTS=4         # start-up retries an unreachable/still-starting database (1s, 2s, 4s apart)
# LMS_DB_LOCK_TIMEOUT_MS=5000   # how long a payment/serialised write waits for its lock

# Backups (npm run db:backup): folder holding pg_dump / pg_restore if they are not on PATH,
# e.g. C:\Program Files\PostgreSQL\17\bin
# PG_BIN=
# Optional: a scratch database URL (owner role) into which each backup is test-restored and counted.
# LMS_BACKUP_VERIFY_URL=

# Automated tests only: a SUPERUSER connection on a development/CI server (never production).
# The tests create and drop their own throw-away databases named lms_test_*.
# LMS_TEST_DATABASE_ADMIN_URL=postgres://postgres:<POSTGRES_PASSWORD>@localhost:5432/postgres

# ---------------------------------------------------------------------------
# Accounts
# ---------------------------------------------------------------------------
# Demo accounts and default fee structures on an EMPTY database. Development only;
# the server will not start in production with this enabled.
# SEED_DEMO_DATA=true

# Public self-registration is OFF by default (accounts are created by an admin or by import).
# To allow it for ONE school, set both values. New accounts wait for an admin's approval.
# ALLOW_PUBLIC_REGISTRATION=true
# PUBLIC_REGISTRATION_SCHOOL_ID=1

# ---------------------------------------------------------------------------
# Email (password reset codes, fee reminders, student setup links)
# ---------------------------------------------------------------------------
# Without these, no email is sent (and password reset by email cannot work).
EMAIL_SERVICE=zoho
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=Core5 Academy <support@example.com>

# ---------------------------------------------------------------------------
# Payments (Razorpay)
# ---------------------------------------------------------------------------
# Without these, online fee payment and paid plans are switched off (HTTP 503).
# Keys belong here only - never in source files.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Paid plan prices in whole rupees per period. A plan without a price cannot be bought.
# The server charges and verifies these amounts; the browser cannot change them.
PLAN_PRICE_STANDARD_INR=
PLAN_PRICE_PROFESSIONAL_INR=
PLAN_PERIOD_DAYS=30

# ---------------------------------------------------------------------------
# Live classes (Jitsi as a Service, https://jaas.8x8.vc)
# ---------------------------------------------------------------------------
# Without these, "Start class" and "Join" answer 503 (scheduling still works).
# JaaS console -> API Keys: add a key, download its private key (PEM). Keep it on the server only.
JAAS_APP_ID=
# The key id from the console ("vpaas-magic-cookie-.../abc123" or just "abc123")
JAAS_API_KEY_ID=
# The PEM text with "\n" for line breaks, or a path to the file in JAAS_PRIVATE_KEY_FILE
JAAS_PRIVATE_KEY=
JAAS_PRIVATE_KEY_FILE=
# JaaS console -> Webhooks: URL https://<api host>/api/live-classes/webhooks/jaas, events
# PARTICIPANT_JOINED, PARTICIPANT_LEFT, ROOM_DESTROYED. Paste the signing secret here.
# Without it webhooks are refused and attendance comes from the in-meeting page only.
JAAS_WEBHOOK_SECRET=
# Minutes a join token stays valid (checked when joining)
JAAS_TOKEN_TTL_MINUTES=10

# ---------------------------------------------------------------------------
# Files, limits and operations
# ---------------------------------------------------------------------------
# Folder for uploaded files. Must be on persistent storage and included in backups.
# Default: server/uploads
# LMS_UPLOADS_DIR=
# How long a file link handed out by the API keeps working (minutes).
UPLOAD_LINK_TTL_MINUTES=240
# Largest JSON request body. Files are uploaded separately and have their own limits.
JSON_BODY_LIMIT=5mb
# Set to true when a process supervisor (PM2, systemd, Docker restart policy) restarts the
# server: an unexpected fatal error then causes a clean restart instead of continuing.
# LMS_EXIT_ON_FATAL=true
# One JSON log line per request (no bodies, tokens or names). Set to "off" to disable.
# LMS_ACCESS_LOG=off

# ---------------------------------------------------------------------------
# Rate limits
# ---------------------------------------------------------------------------
# Overall ceiling per IP address. Login and password reset have their own, stricter limits.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=3000

# ---------------------------------------------------------------------------
# AI provider - Hugging Face (backend only; never put this in frontend code)
# Read by the AI Assessment Agent (test generation, performance reports, assignment
# evaluation) and by server/services/notificationText.js for notification wording.
# HF_TOKEN must be a real Hugging Face token ("hf_...") for AI to switch on;
# left empty, AI stays off and the LMS uses its standard text.
# ---------------------------------------------------------------------------
AIA_LLM_PROVIDER=huggingface
# "org/model" or "org/model:inference-provider" - confirm the model you want to use
AIA_LLM_MODEL=Qwen/Qwen3-Next-80B-A3B-Instruct:deepinfra
HF_TOKEN=

# --- Help assistant (universalChatbot); POST /api/assistant/api/v1/chat forwards questions with the verified role ---
CHATBOT_URL=http://127.0.0.1:8000
CHATBOT_APP_ID=default
# Same value as LMS_CALLER_KEY in universalChatbot/.env. Empty = the assistant answers 503.
CHATBOT_CALLER_KEY=
